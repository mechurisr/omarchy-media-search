#!/usr/bin/env python3
"""Cover art for Media Search.

Players hand over cover art as a URL. A remote one is downloaded here rather
than by Qt's Image, which would buffer the whole response inside the shell
process before decoding it, with no limit on its size:

  art-helper fetch URL    download URL into the cache, print "PATH<TAB>URL"

Only http(s) is fetched, only an image/* response is kept, and the download
stops at MAX_BYTES or after DEADLINE seconds in total. Any failure prints
nothing and exits non-zero, so the panel just shows its placeholder.
"""

import hashlib
import os
import signal
import sys
import urllib.error
import urllib.request

MAX_BYTES = 4 * 1024 * 1024
DEADLINE = 10
CHUNK = 64 * 1024
KEEP_FILES = 64

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "omarchy-media-search", "art")


class HttpOnlyRedirects(urllib.request.HTTPRedirectHandler):
    """A redirect may only lead to another http(s) URL."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.lower().startswith(("http://", "https://")):
            return None
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def prune():
    try:
        entries = [os.path.join(CACHE_DIR, n) for n in os.listdir(CACHE_DIR)]
        entries = [p for p in entries if os.path.isfile(p)]
        entries.sort(key=os.path.getmtime, reverse=True)
        for path in entries[KEEP_FILES:]:
            os.remove(path)
    except OSError:
        pass


def out_of_time(signum, frame):
    raise TimeoutError("cover art download took too long")


def download(url, dest):
    # The socket timeout only bounds each read, so a server dribbling bytes
    # would keep going; the alarm caps the whole fetch, DNS included.
    signal.signal(signal.SIGALRM, out_of_time)
    signal.alarm(DEADLINE)
    opener = urllib.request.build_opener(HttpOnlyRedirects)
    request = urllib.request.Request(url, headers={"User-Agent": "omarchy-media-search"})
    tmp = dest + ".%d.tmp" % os.getpid()
    try:
        with opener.open(request, timeout=DEADLINE) as resp:
            if not resp.headers.get_content_type().startswith("image/"):
                return False
            length = resp.headers.get("Content-Length")
            if length and length.isdigit() and int(length) > MAX_BYTES:
                return False
            size = 0
            with open(tmp, "wb") as out:
                while True:
                    chunk = resp.read1(CHUNK)
                    if not chunk:
                        break
                    size += len(chunk)
                    if size > MAX_BYTES:
                        return False
                    out.write(chunk)
        if size == 0:
            return False
        os.replace(tmp, dest)
        return True
    except (OSError, ValueError, urllib.error.URLError):
        return False
    finally:
        signal.alarm(0)
        if os.path.exists(tmp):
            os.remove(tmp)


def cmd_fetch(args):
    if len(args) != 1 or not args[0].lower().startswith(("http://", "https://")):
        return 1
    url = args[0]
    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    dest = os.path.join(CACHE_DIR, hashlib.sha256(url.encode()).hexdigest()[:32])
    if os.path.isfile(dest):
        os.utime(dest)
    elif not download(url, dest):
        return 1
    else:
        prune()
    print("%s\t%s" % (dest, url))
    return 0


COMMANDS = {
    "fetch": cmd_fetch,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    return COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
